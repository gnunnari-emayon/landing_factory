{
  "name": "nicho-landing-factory",
  "version": "1.0.0",
  "description": "Plataforma de generación de landing pages por nicho y CRM commercial",
  "main": "backend/main.py",
  "scripts": {
    "build:css": "sass frontend/scss/main.scss frontend/css/main.css",
